# URL do projeto Supabase (Settings → API → Project URL)
# Exemplo: https://abcdefgh.supabase.co
SUPABASE_URL=

# Chave pública do Supabase (Settings → API → anon public)
# Segura pra expor no front, respeita RLS.
SUPABASE_ANON_KEY=

# Chave de serviço do Supabase (Settings → API → service_role)
# SECRETA. Nunca expor, nunca commitar, nunca colar em chat.
SUPABASE_SERVICE_KEY=

# Ambiente: 'dev' libera CORS de localhost; 'prod' restringe
ENV=dev

# Mercado Pago — Checkout
# Access Token da aplicação MP.
# Sandbox: prefixo "TEST-" (ex: TEST-1234567890...)
# Produção: string longa (ex: APP_USR-...)
# Pega em: Painel Dev → Suas integrações → sua aplicação → Credenciais de teste/produção
MP_ACCESS_TOKEN=

# Public Key da aplicação MP (usada no front, opcional no backend por enquanto).
# Pega no mesmo lugar que o Access Token.
MP_PUBLIC_KEY=

# Assinatura secreta do Webhook.
# Gera automaticamente ao configurar Webhook no painel.
# Pega em: Suas integrações → sua aplicação → Webhooks → Configurar notificação → "Assinatura secreta" → Revelar
MP_WEBHOOK_SECRET=

# 'sandbox' ou 'production'. Define a base URL da API MP no client.
MP_ENV=sandbox

# flag para debugging com logs detalhados
MP_DEBUG_ERRORS=false

# Origens CORS extras, comma-separated.
# Use pra domínios temporários de teste (ex: croma-drip-front-teste.fly.dev)
# sem precisar mexer no código. Deixe vazio quando o domínio oficial estiver no ar.
# Ex: https://croma-drip-front-teste.fly.dev,https://outro-ambiente.fly.dev
EXTRA_CORS_ORIGINS=

# Cloudinary — storage de imagens de produto.
# Pega em: https://console.cloudinary.com/
# Dashboard → Product Environment Credentials → "Cloud name", "API Key", "API Secret"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pasta base no Cloudinary onde as imagens vão ser salvas.
# Organiza o bucket por produto: {folder}/{product_id}/{uuid}
CLOUDINARY_FOLDER=croma/products