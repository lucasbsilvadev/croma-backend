# URL do projeto Supabase (Settings → API → Project URL)
# Exemplo: https://abcdefgh.supabase.co
SUPABASE_URL=

# Chave pública do Supabase (Settings → API → anon public)
# Segura pra expor no front, respeita RLS.
SUPABASE_ANON_KEY=

# Chave de serviço do Supabase (Settings → API → service_role)
# SECRETA. Nunca expor, nunca commitar, nunca colar em chat.
SUPABASE_SERVICE_KEY=

# Ambiente: 'dev' libera CORS de localhost; 'prod' restringe
ENV=dev